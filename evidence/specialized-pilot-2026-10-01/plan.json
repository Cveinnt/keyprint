    {
      "id": "sql_approval",
      "domain": "sql",
      "prompt": "Return only one SQLite SELECT query, no Markdown. Table orders(id INTEGER, approved INTEGER, blocked INTEGER). Return id for orders with approved exactly 1 and blocked exactly 0, sorted by id ascending. NULL means unknown and must not be treated as approval or an unblocked state. Do not modify the database.",
      "setup": "CREATE TABLE orders(id INTEGER, approved INTEGER, blocked INTEGER); INSERT INTO orders VALUES (1,1,0),(2,0,0),(3,1,1),(4,NULL,0),(5,1,NULL),(6,1,0),(7,2,0),(8,1,2);",
      "expected": [
        [
          1
        ],
        [
          6
        ]
      ],
      "reference": "SELECT id FROM orders WHERE approved = 1 AND blocked = 0 ORDER BY id;"
    },
    {
      "id": "sql_inventory",
      "domain": "sql",
      "prompt": "Return only one SQLite SELECT query, no Markdown. Table stock(warehouse TEXT, on_hand INTEGER, reserved INTEGER). All counts are nonnegative and non-NULL. Return warehouse and SUM(on_hand - reserved) AS available, grouped by warehouse. Include only warehouses whose available total is strictly greater than 0. Sort by warehouse ascending. Do not filter individual rows before summing or modify the database.",
      "setup": "CREATE TABLE stock(warehouse TEXT,on_hand INTEGER,reserved INTEGER); INSERT INTO stock VALUES ('A',10,3),('A',0,8),('B',9,2),('B',3,3),('C',5,5),('D',20,2),('D',2,5);",
      "expected": [
        [
          "B",
          7
        ],
        [
          "D",
          15
        ]
      ],
      "reference": "SELECT warehouse, SUM(on_hand - reserved) AS available FROM stock GROUP BY warehouse HAVING SUM(on_hand - reserved) > 0 ORDER BY warehouse;"
    },
    {
